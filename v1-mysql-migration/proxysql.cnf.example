# ProxySQL 설정 예시 (실제 파일은 저장소에 두지 않는다)
# - 서버 배치 경로: /opt/lookddak/v1-mysql-migration/proxysql.cnf (권한 600, 컨테이너에서 읽을 수 있어야 함)
# - <...> 값을 채워서 사용한다. 비밀번호가 들어가므로 커밋하지 않는다.
# - datadir 볼륨이 없으므로 컨테이너를 다시 만들면 이 파일 기준으로 올라온다.
#   admin에서 런타임으로 바꾼 값(예: 전환 후 백엔드 주소)은 이 파일에도 반영해야 유지된다.
# - 파일 하나만 bind mount하므로 수정할 때 sed -i·편집기 저장(새 파일로 교체)을 쓰면
#   컨테이너가 옛 파일을 계속 본다. 사본을 고친 뒤 `cat 사본 > proxysql.cnf`로 덮어쓴다.
# - 재시작 없이 반영: admin에서 `LOAD MYSQL QUERY RULES FROM CONFIG; LOAD MYSQL QUERY RULES TO RUNTIME;`

datadir="/var/lib/proxysql"

admin_variables=
{
  # admin: 컨테이너 내부(localhost) 접속용
  # radmin: EC2에서 127.0.0.1:6032 포트 매핑으로 접속하는 용도 (admin 계정은 원격 접속 불가)
  admin_credentials="admin:<ADMIN_PASSWORD>;radmin:<ADMIN_PASSWORD>"
  mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
  interfaces="0.0.0.0:6033"
  server_version="8.4.11"
  threads=2
  max_connections=512

  # Spring → ProxySQL 구간 TLS (JDBC sslMode=REQUIRED 대응, 첫 기동 시 자체 서명 인증서 생성)
  have_ssl=true

  # 전환 중 쓰기 대상이 없을 때 쿼리를 붙잡아 두는 최대 시간(ms)
  connect_timeout_server_max=30000
  default_query_timeout=60000

  # 백엔드가 하나이고 전환을 수동으로 하므로 Monitor는 끈다.
  # (켜 두면 RDS에 모니터 계정이 필요하고, 없으면 ping 실패로 백엔드가 SHUNNED될 수 있다)
  monitor_enabled=false

  # INSERT 뒤 연결 고정 안 함 (앱이 LAST_INSERT_ID()를 따로 조회하지 않음, 기본값 5)
  auto_increment_delay_multiplex=0
}

mysql_servers=
(
  # use_ssl=1: ProxySQL → RDS 구간 TLS (require_secure_transport=1 대응)
  { hostgroup_id=10, hostname="<RDS_ENDPOINT>", port=3306, use_ssl=1, max_connections=100 }
)

mysql_users=
(
  # Spring이 쓰는 앱 계정과 같아야 한다 (/lookddak/<env>/rds/app/*)
  { username="<APP_USERNAME>", password="<APP_PASSWORD>", default_hostgroup=10, transaction_persistent=1 }
)

# 세션 고정(멀티플렉싱 해제) 방지
# ProxySQL은 @@ 변수를 조회하는 쿼리를 받으면 그 세션을 백엔드 연결에 고정한다.
# 고정된 세션은 OFFLINE_SOFT 이후에도 기존 DB로 쿼리를 보내므로, 전환 전에 연결이 비지 않는다(ConnUsed > 0).
# 아래 쿼리들이 읽는 값(문자셋, sql_mode, 격리 수준, read-only)은 ProxySQL이 세션별로 추적해 백엔드에 맞춰 주므로
# multiplex=2(이 쿼리로 고정하지 않음)로 지정해도 결과가 같다.
mysql_query_rules=
(
  # Connector/J가 연결을 만들 때 보내는 @@ 조회
  { rule_id=10, active=1, match_digest="^SELECT @@session\\.auto_increment_increment AS auto_increment_increment", multiplex=2, apply=0 },
  # @Transactional(readOnly) 때 Connector/J가 보내는 read-only 상태 조회 (SET SESSION TRANSACTION READ ONLY/WRITE는 ProxySQL이 추적)
  { rule_id=11, active=1, match_digest="^SELECT @@session\\.transaction_read_only$", multiplex=2, apply=0 },
  # Hikari/Hibernate 기동 시 격리 수준 조회
  { rule_id=12, active=1, match_digest="^SELECT @@session\\.transaction_isolation$", multiplex=2, apply=0 },
  # Connector/J 기동 시 메타데이터 조회
  { rule_id=13, active=1, match_digest="^SELECT @@character_set_database,@@sql_mode$", multiplex=2, apply=0 }
)
