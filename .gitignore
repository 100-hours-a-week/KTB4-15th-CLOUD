# Terraform 작업 폴더 (provider 바이너리, 모듈 캐시)
.terraform/

# State (S3에서 관리, 민감 정보 포함)
*.tfstate
*.tfstate.*

# Plan 결과 (민감 정보 포함 가능)
tfplan
*.tfplan
plan.txt

# 변수 값 파일 (민감 값이 들어갈 수 있음)
*.tfvars
*.tfvars.json

# 로그 및 로컬 override
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS / 에디터
.DS_Store
.idea/
.vscode/

