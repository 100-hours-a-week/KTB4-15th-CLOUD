# Non-secret deployment values. Copy to /srv/lookddak/deploy.env.
AWS_REGION=ap-northeast-2
DOMAIN=dev.lookddak.com
CERTBOT_EMAIL=team@example.com

# Use immutable ECR digest references after each image has been built for linux/arm64.
NEXTJS_IMAGE=686496667254.dkr.ecr.ap-northeast-2.amazonaws.com/lookddak-dev-nextjs@sha256:REPLACE_ME
SPRING_IMAGE=686496667254.dkr.ecr.ap-northeast-2.amazonaws.com/lookddak-dev-spring@sha256:REPLACE_ME
FASTAPI_IMAGE=686496667254.dkr.ecr.ap-northeast-2.amazonaws.com/lookddak-dev-fastapi@sha256:REPLACE_ME
CRAWLER_IMAGE=686496667254.dkr.ecr.ap-northeast-2.amazonaws.com/lookddak-dev-crawler@sha256:REPLACE_ME
