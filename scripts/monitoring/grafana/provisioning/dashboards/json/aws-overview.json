{
  "uid": "lookddak-aws-overview",
  "title": "AWS Overview",
  "description": "ALB·ECS·RDS (CloudWatch → YACE). ALB 전체는 1분, 나머지는 5분 단위. V1 타깃그룹은 제외",
  "tags": [
    "lookddak",
    "aws"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "ALB 전체 (1분)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "요청 수 (1분 합계)",
      "description": "ALB 전체 요청 수. CloudWatch RequestCount, 1분 합계. 최근 1~2개 점은 집계 중이라 낮게 보일 수 있음",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(aws_applicationelb_request_count_sum{dimension_TargetGroup=\"\"})",
          "legendFormat": "요청 수"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "응답시간 (1분)",
