# ---------------------------------------------------------------
# 알림 파이프라인 장애 알림용 토픽 (DLQ 알람 → 이메일)
# 이메일 구독은 개인 이메일 주소가 저장소에 노출되지 않도록 콘솔에서 관리한다.
# 토픽 정책은 계정 기본 정책뿐이라 따로 관리하지 않는다.
# ---------------------------------------------------------------
resource "aws_sns_topic" "alert_pipeline" {
  name = "lookddak-alert-pipeline"
}
