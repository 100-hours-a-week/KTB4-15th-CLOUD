{
  "family": "lookddak-dev-v2-crawler",
  "taskRoleArn": "arn:aws:iam::686496667254:role/lookddak-dev-v2-crawler-task",
  "executionRoleArn": "arn:aws:iam::686496667254:role/lookddak-dev-v2-task-execution",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "crawler",
      "image": "686496667254.dkr.ecr.ap-northeast-2.amazonaws.com/lookddak-dev-crawler@sha256:REPLACED_BY_CI",
      "essential": true,
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "ap-northeast-2"
        },
        {
          "name": "S3_BUCKET",
          "value": "lookddak-dev-images-686496667254-ap-northeast-2"
        },
        {
          "name": "TZ",
          "value": "Asia/Seoul"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "/lookddak/dev/v2/postgresql/app/database-url"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/lookddak/dev/v2/crawler",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "privileged": false,
      "readonlyRootFilesystem": false
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "tags": [
    {
      "key": "Environment",
      "value": "dev"
    },
    {
      "key": "Service",
      "value": "crawler"
    },
    {
      "key": "Version",
      "value": "v2"
    }
  ]
}
